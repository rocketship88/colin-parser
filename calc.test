# ---------- Two Argument Functions with Variables ----------

test calc-28.1 {min with variables} -constraints hasCalcCmd -setup {
    set a 7
    set b 12
} -body {
    expr {[$calcCmd min(a, b)] == [expr {min($a, $b)}]}
