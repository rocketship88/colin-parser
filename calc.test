# ---------- Pre-Substitution in Procs (Runtime Fallback) ----------

test calc-39.1 {variable substitution in proc} -constraints hasCalcCmd -body {
    proc test_var_subst {a b} {
        = $a + $b
    }
    test_var_subst 10 20
} -result 30 -cleanup {
    rename test_var_subst {}
}

test calc-39.2 {mixed literal and substitution} -constraints hasCalcCmd -body {
    proc test_mixed {n} {
        = $n * 2 + 5
    }
    test_mixed 10
} -result 25 -cleanup {
    rename test_mixed {}
}

test calc-39.3 {command substitution in proc} -constraints hasCalcCmd -body {
    proc test_cmd_subst {x} {
        = [expr {$x * 2}] + 10
    }
    test_cmd_subst 5
} -result 20 -cleanup {
    rename test_cmd_subst {}
}

# ---------- Edge Cases and Security Tests ----------

test calc-40.1 {comma operator only in function args} -constraints hasCalcCmd -body {
    catch {$calcCmd 4,10} result
    string match "*Expected*" $result
} -result 0

test calc-40.2 {pre-substitution with simple variables} -constraints hasCalcCmd -setup {
    set x 10
    set y 20
} -body {
    proc test_presub {a b} {
        = $a + $b
    }
    test_presub $x $y
} -result 30 -cleanup {
    rename test_presub {}
    unset x y
}

test calc-40.3 {pre-substitution with non-numeric fails gracefully} -constraints hasCalcCmd -body {
    proc test_non_numeric {a} {
        = $a + 1
    }
    # Just check that it errors, don't check specific message
    catch {test_non_numeric "hello"}
} -result 1 -cleanup {
    rename test_non_numeric {}
}

test calc-40.4 {concatenated pre-substitution} -constraints hasCalcCmd -setup {
    set x 5
    set y 10
} -body {
    proc test_concat {a b} {
        = $a+$b
    }
    test_concat $x $y
} -result 15 -cleanup {
    rename test_concat {}
    unset x y
}

test calc-40.5 {expression injection via global variable} -constraints hasCalcCmd -setup {
    set ::testvar 100
    set x "::testvar"
} -body {
    # This evaluates "1+::testvar" which accesses the global
    expr {[$calcCmd 1 + $x] == 101}
} -result 1 -cleanup {
    unset ::testvar x
}

test calc-40.6 {invalid character in expression} -constraints hasCalcCmd -body {
    catch {$calcCmd 1 + \[pwd]} result
    string match "*Expected*" $result
} -result 0

test calc-40.7 {backslash in expression} -constraints hasCalcCmd -body {
    catch {$calcCmd 1 + \\} result
    string match "*Expected*" $result
} -result 0

test calc-40.8 {semicolon in expression} -constraints hasCalcCmd -body {
    catch {$calcCmd {1 + 2; 3)}} result
    string match "*Expected*" $result
} -result 0

test calc-40.9 {mismatched parentheses} -constraints hasCalcCmd -body {
    catch {$calcCmd {(1 + 2}} result
    string match "*Expected*)*" $result
} -result 0

test calc-40.10 {operator without operand} -constraints hasCalcCmd -body {
    catch {$calcCmd 1 +}
} -result 1

test calc-40.11 {global variable with ::} -constraints hasCalcCmd -setup {
    set ::globalval 42
} -body {
    $calcCmd ::globalval * 2
} -result 84 -cleanup {
    unset ::globalval
}

test calc-40.12 {namespace variable} -constraints hasCalcCmd -setup {
    namespace eval ::testns {
        variable nsvar 25
    }
} -body {
    $calcCmd ::testns::nsvar + 5
} -result 30 -cleanup {
    namespace delete ::testns
}

test calc-40.13 {non-existent variable} -constraints hasCalcCmd -body {
    catch {$calcCmd noSuchVar + 1} result
    string match "*can't read*noSuchVar*" $result
} -result 1

test calc-40.14 {empty expression} -constraints hasCalcCmd -body {
    catch {$calcCmd} result
    string match "*wrong # args*" $result
} -result 1

test calc-40.15 {expression with only operators} -constraints hasCalcCmd -body {
    catch {$calcCmd + *} result
    string match "*Expected*" $result
} -result 0

test calc-40.16 {pre-sub numeric check with integer} -constraints hasCalcCmd -setup {
    set val 42
} -body {
    proc test_int {x} {
        = $x * 2
    }
    test_int $val
} -result 84 -cleanup {
    rename test_int {}
    unset val
}

test calc-40.17 {pre-sub numeric check with double} -constraints hasCalcCmd -setup {
    set val 3.14
} -body {
    proc test_double {x} {
        = $x * 2
    }
    test_double $val
} -result 6.28 -cleanup {
    rename test_double {}
    unset val
}

test calc-40.18 {pre-sub numeric check with bignum} -constraints hasCalcCmd -setup {
    set val 999999999999999999999
} -body {
    proc test_bignum {x} {
        = $x + 1
    }
    test_bignum $val
} -result 1000000000000000000000 -cleanup {
    rename test_bignum {}
    unset val
}

test calc-40.19 {mixed literal and pre-substitution in proc} -constraints hasCalcCmd -body {
    proc test_mixed {a b} {
        = $a + b * 2
    }
    test_mixed 5 10
} -result 25 -cleanup {
    rename test_mixed {}
}

test calc-40.20 {pre-sub with expression fragment in value} -constraints hasCalcCmd -setup {
    set fragment "1+1"
} -body {
    proc test_fragment {x} {
        = $x + 10
    }
    # x contains "1+1" which gets evaluated as expression
    test_fragment $fragment
} -result 12 -cleanup {
    rename test_fragment {}
    unset fragment
}

test calc-40.21 {multiple pre-substitutions all numeric} -constraints hasCalcCmd -setup {
    set a 1
    set b 2
    set c 3
} -body {
    proc test_multi {x y z} {
        = $x + $y + $z
    }
    test_multi $a $b $c
} -result 6 -cleanup {
    rename test_multi {}
    unset a b c
}

test calc-40.22 {multiple pre-subs with one non-numeric} -constraints hasCalcCmd -setup {
    set a 1
    set b "bad"
    set c 3
} -body {
    proc test_mixed {x y z} {
        = $x + $y + $z
    }
    # Just check that it errors
    catch {test_mixed $a $b $c}
} -result 1 -cleanup {
    rename test_mixed {}
    unset a b c
}

test calc-40.23 {division by zero with pre-sub} -constraints hasCalcCmd -setup {
    set zero 0
} -body {
    proc test_divzero {x} {
        = 10 / $x
    }
    catch {test_divzero $zero} result
    string match "*divide by zero*" $result
} -result 1 -cleanup {
    rename test_divzero {}
    unset zero
}

test calc-40.24 {unary minus with pre-sub} -constraints hasCalcCmd -setup {
    set val 5
} -body {
    proc test_unary {x} {
        = -$x + 10
    }
    test_unary $val
} -result 5 -cleanup {
    rename test_unary {}
    unset val
}

test calc-40.25 {parenthesized pre-sub} -constraints hasCalcCmd -setup {
    set a 5
    set b 3
} -body {
    proc test_parens {x y} {
        = ($x + $y) * 2
    }
    test_parens $a $b
} -result 16 -cleanup {
    rename test_parens {}
    unset a b
}

test calc-40.26 {function call with pre-sub arg} -constraints hasCalcCmd -setup {
    set val 16
} -body {
    proc test_func {x} {
        = sqrt($x)
    }
    test_func $val
} -result 4.0 -cleanup {
    rename test_func {}
    unset val
}

test calc-40.27 {nested function calls with pre-sub} -constraints hasCalcCmd -setup {
    set val 3
} -body {
    proc test_nested {x} {
        = abs(sin($x))
    }
    expr {[test_nested $val] >= 0}
} -result 1 -cleanup {
    rename test_nested {}
    unset val
}


test calc-40.28 {pre-sub in ternary operator} -constraints {hasCalcCmd hasTernary stackProblem} -setup {
    set cond 1
    set iftrue 10
    set iffalse 20
} -body {
    proc test_ternary {c t f} {
        = $c ? $t : $f
    }
    test_ternary $cond $iftrue $iffalse
} -result 10 -cleanup {
    rename test_ternary {}
    unset cond iftrue iffalse
}

puts "after 40.28"

test calc-40.29 {pre-sub with logical operators} -constraints {hasCalcCmd hasLogicalOps stackProblem} -setup {
    set x 1
    set y 0
} -body {
    proc test_logical {a b} {
        = $a && $b
    }
    test_logical $x $y
} -result 0 -cleanup {
    rename test_logical {}
    unset x y
}

puts "after 40.29"

test calc-40.30 {comparison with pre-sub} -constraints hasCalcCmd -setup {
    set a 10
    set b 20
} -body {
    proc test_compare {x y} {
        = $x < $y
    }
    test_compare $a $b
} -result 1 -cleanup {
    rename test_compare {}
    unset a b
}

test calc-40.31 {runtime path with literal bracket} -constraints hasCalcCmd -body {
    # At command line (runtime path), literal [ should error gracefully
    catch {$calcCmd {[}} result
    string match "*Expected*" $result
} -result 0

test calc-40.32 {compile path catches non-compilable} -constraints hasCalcCmd -body {
    # Command substitution should trigger runtime fallback
    proc test_cmdsub {} {
        = [expr {5}] + 1
    }
    test_cmdsub
} -result 6 -cleanup {
    rename test_cmdsub {}
}

# ============================================================================
# SEVERAL && / || IN ONE COMPILED BODY (labels must be unique per use)
# ============================================================================

test calc-41.1 {three || in one expression, proc=} -constraints {hasCalcCmd hasLogicalOps} -body {
    proc= t41_1 {a b c} {= (a < 0) || (b < 0) || (c < 0)}
    list [t41_1 1 1 1] [t41_1 1 -1 1] [t41_1 1 1 -1] [t41_1 -1 1 1]
} -result {0 1 1 1} -cleanup {
    rename t41_1 {}
}

test calc-41.2 {|| in two statements of one body} -constraints {hasCalcCmd hasLogicalOps} -body {
    proc= t41_2 {a b c} {
        = { x = (a < 0) || (b < 0); y = (b < 0) || (c < 0); x*2 + y }
    }
    list [t41_2 1 1 1] [t41_2 -1 1 1] [t41_2 1 -1 1] [t41_2 1 1 -1]
} -result {0 2 3 1} -cleanup {
    rename t41_2 {}
}

test calc-41.3 {|| mixed with &&, matches expr} -constraints {hasCalcCmd hasLogicalOps} -body {
    proc= t41_3c {a b c} {= !(((a<0)||(b<0)||(c<0)) && ((a>0)||(b>0)||(c>0)))}
    proc t41_3e {a b c} {expr {!((($a<0)||($b<0)||($c<0)) && (($a>0)||($b>0)||($c>0)))}}
    set bad {}
    foreach a {-2 0 3} {foreach b {-1 0 5} {foreach c {-4 0 7} {
        if {[t41_3c $a $b $c] != [t41_3e $a $b $c]} {lappend bad [list $a $b $c]}
    }}}
    set bad
} -result {} -cleanup {
    rename t41_3c {}
    rename t41_3e {}
}

test calc-41.4 {&& and || in ternary branches} -constraints {hasCalcCmd hasLogicalOps hasTernary} -body {
    proc= t41_4 {a b c} {= a > 0 ? (b > 0 && c > 0 ? 1 : 2) : (b < 0 || c < 0 ? 3 : 4)}
    list [t41_4 1 1 1] [t41_4 1 1 -1] [t41_4 -1 -1 1] [t41_4 -1 1 1]
} -result {1 2 3 4} -cleanup {
    rename t41_4 {}
}

test calc-41.5 {two && operators, Calc::transformProcs} -constraints {hasCalcCmd hasLogicalOps} -body {
    proc t41_5 {a b c} {= (a > 0) && (b > 0) && (c > 0)}
    Calc::transformProcs t41_5
    list [t41_5 1 1 1] [t41_5 1 1 0] [t41_5 0 1 1]
} -result {1 0 0} -cleanup {
    rename t41_5 {}
}

# ============================================================================
# TUPLES - destructuring assignment, nested patterns, "->", "_" skip, list builder
# ============================================================================

test calc-42.1 {tuple assignment: (x,y,z) = list} -constraints hasCalcCmd -body {
    set pt {3 4 5}
    = (x, y, z) = pt
    list $x $y $z
} -result {3 4 5} -cleanup {
    unset -nocomplain pt x y z
}

test calc-42.2 {tuple assignment returns the whole list} -constraints hasCalcCmd -body {
    set pt {3 4 5}
    = (x, y, z) = pt
} -result {3 4 5} -cleanup {
    unset -nocomplain pt x y z
}

test calc-42.3 {tuple with ->: value -> (pattern)} -constraints hasCalcCmd -body {
    set pt {3 4 5}
    = pt -> (x, y, z)
    list $x $y $z
} -result {3 4 5} -cleanup {
    unset -nocomplain pt x y z
}

test calc-42.4 {tuple with -> returns the list} -constraints hasCalcCmd -body {
    set pt {3 4 5}
    = pt -> (x, y, z)
} -result {3 4 5} -cleanup {
    unset -nocomplain pt x y z
}

test calc-42.5 {tuple: extra elements are ignored} -constraints hasCalcCmd -body {
    set v {1 2 3 4 5}
    = (a, b) = v
    list $a $b
} -result {1 2} -cleanup {
    unset -nocomplain v a b
}

test calc-42.6 {tuple: missing elements are empty strings} -constraints hasCalcCmd -body {
    set v {1 2}
    = (a, b, c) = v
    list $a $b [string length $c]
} -result {1 2 0} -cleanup {
    unset -nocomplain v a b c
}

test calc-42.7 {tuple: _ skips an element} -constraints hasCalcCmd -body {
    set v {3 4 5}
    = (first, _, last) = v
    list $first $last [info exists _]
} -result {3 5 0} -cleanup {
    unset -nocomplain v first last _
}

test calc-42.8 {tuple: nested pattern} -constraints hasCalcCmd -body {
    set edge {{1 2} {7 9}}
    = ((x1, y1), (x2, y2)) = edge
    list $x1 $y1 $x2 $y2
} -result {1 2 7 9} -cleanup {
    unset -nocomplain edge x1 y1 x2 y2
}

test calc-42.9 {tuple: nested pattern with -> and _} -constraints hasCalcCmd -body {
    set edge {{1 2} {7 9}}
    = edge -> ((x1, _), (_, y2))
    list $x1 $y2
} -result {1 9} -cleanup {
    unset -nocomplain edge x1 y2 _
}

test calc-42.10 {tuple: swap, the right side is built before storing} -constraints hasCalcCmd -body {
    set a 1
    set b 2
    = (a, b) = (b, a)
    list $a $b
} -result {2 1} -cleanup {
    unset -nocomplain a b
}

test calc-42.11 {list builder: (a,b) builds a list} -constraints hasCalcCmd -body {
    = (1+2, 3*3)
} -result {3 9}

test calc-42.12 {list builder: same as list()} -constraints hasCalcCmd -body {
    set x 10
    set y 20
    list [= (x, y, x+y)] [= list(x, y, x+y)]
} -result {{10 20 30} {10 20 30}} -cleanup {
    unset -nocomplain x y
}

test calc-42.13 {list builder: nested} -constraints hasCalcCmd -body {
    = ((1,2),(3,4))
} -result {{1 2} {3 4}}

test calc-42.14 {list builder into nested pattern} -constraints hasCalcCmd -body {
    = ((a, b), (c, d)) = ((1,2),(3,4))
    list $a $b $c $d
} -result {1 2 3 4} -cleanup {
    unset -nocomplain a b c d
}

test calc-42.15 {parentheses without a comma are still grouping} -constraints hasCalcCmd -body {
    list [= (1+2)*3] [= (1+2)] [= ((2))]
} -result {9 3 2}

test calc-42.16 {-> does not break comparisons: x<-1 and x>-1} -constraints hasCalcCmd -body {
    set x 0
    list [= x<-1] [= x>-1] [= x < -1] [= x > -1]
} -result {0 1 0 1} -cleanup {
    unset -nocomplain x
}

test calc-42.17 {tuple pattern: a number is an error} -constraints hasCalcCmd -body {
    set pt {3 4 5}
    catch {= (a, 1) = pt} msg
    set msg
} -result {Calc: expected a variable name in a pattern but found '1'} -cleanup {
    unset -nocomplain pt a
}

test calc-42.18 {tuple pattern: an expression is an error} -constraints hasCalcCmd -body {
    set pt {3 4 5}
    catch {= (a, b+1) = pt} msg
    set msg
} -result {Calc: expected ',' or ')' in a pattern but found '+'} -cleanup {
    unset -nocomplain pt a
}

test calc-42.19 {tuple in proc=} -constraints hasCalcCmd -body {
    proc= t42_19 {v} {= {(p, _, q) = v; p*10 + q}}
    t42_19 {1 2 3}
} -result 13 -cleanup {
    rename t42_19 {}
}

test calc-42.20 {tuple in proc=: variables are local} -constraints hasCalcCmd -body {
    proc= t42_20 {v} {= {(p, q) = v; p + q}}
    unset -nocomplain p q
    set r [t42_20 {3 4}]
    list $r [info exists p] [info exists q]
} -result {7 0 0} -cleanup {
    rename t42_20 {}
    unset -nocomplain r
}

test calc-42.21 {nested tuple in proc=: edge length} -constraints hasCalcCmd -body {
    proc= t42_21 {edge} {
        = {
            ((x1,y1),(x2,y2)) = edge;
            hypot(x2-x1, y2-y1)
        }
    }
    t42_21 {{0 0} {3 4}}
} -result 5.0 -cleanup {
    rename t42_21 {}
}

test calc-42.22 {list builder and nested tuple in proc=} -constraints hasCalcCmd -body {
    proc= t42_22 {t1 t2 t3} {
        = {
            ((ax,ay),(bx,by),(cx,cy)) = (t1,t2,t3);
            ax + by + cx
        }
    }
    t42_22 {1 2} {3 4} {5 6}
} -result 10 -cleanup {
    rename t42_22 {}
}

test calc-42.23 {tuple with Calc::transformProcs} -constraints hasCalcCmd -body {
    proc t42_23 {v} {= {(p, q) = v; p + q}}
    Calc::transformProcs t42_23
    t42_23 {3 4}
} -result 7 -cleanup {
    rename t42_23 {}
}

test calc-42.24 {tuple in method=} -constraints hasCalcCmd -body {
    oo::class create C42_24 {
        method= m {v} {= {(a, b) = v; a + b}}
    }
    [C42_24 new] m {4 5}
} -result 9 -cleanup {
    C42_24 destroy
}

test calc-42.25 {tuple in calc=} -constraints hasCalcCmd -body {
    calc= t42_25 {
        set e {{1 2} {7 9}}
        = e -> ((u, _), (_, w))
    }
    list $u $w
} -result {1 9} -cleanup {
    unset -nocomplain e u w _
}

# ============================================================================
# STRICT TUPLE ASSIGNMENT  (value => pattern): sizes must match exactly
# ============================================================================

test calc-43.1 {=> flat pattern, sizes match} -constraints hasCalcCmd -body {
    set pt {3 4 5}
    = pt => (x, y, z)
    list $x $y $z
} -result {3 4 5} -cleanup {
    unset -nocomplain pt x y z
}

test calc-43.2 {=> nested pattern, sizes match} -constraints hasCalcCmd -body {
    set D {{1 2} {3 4} {5 6}}
    = D => ((ax,ay),(bx,by),(cx,cy))
    list $ax $ay $bx $by $cx $cy
} -result {1 2 3 4 5 6} -cleanup {
    unset -nocomplain D ax ay bx by cx cy
}

test calc-43.3 {=> pattern longer than data is an error} -constraints hasCalcCmd -body {
    set D {{1 2} {3 4} {5 6}}
    = D => (ax,ay,bx,by,cx,cy)
} -returnCodes error -match glob -result {*tuple mismatch: pattern (ax,ay,bx,by,cx,cy) expects 6, data has 3*} -cleanup {
    unset -nocomplain D
}

test calc-43.4 {=> data longer than pattern is an error} -constraints hasCalcCmd -body {
    = (1,2,3,4) => (p,q)
} -returnCodes error -match glob -result {*pattern (p,q) expects 2, data has 4*}

test calc-43.5 {=> group against a single value is an error} -constraints hasCalcCmd -body {
    = (1,2) => ((p,q),(r,s))
} -returnCodes error -match glob -result {*pattern (p,q) expects 2, data has 1*}

test calc-43.6 {=> mismatch in an inner group names that group} -constraints hasCalcCmd -body {
    set D {{1 2} {3 4} {5 6}}
    = D => ((ax,ay),(bx),(cx,cy))
} -returnCodes error -match glob -result {*pattern (bx) expects 1, data has 2*} -cleanup {
    unset -nocomplain D
}

test calc-43.7 {=> an outer mismatch assigns nothing} -constraints hasCalcCmd -body {
    unset -nocomplain p q r
    catch {= (1,2) => (p,q,r)}
    list [info exists p] [info exists q] [info exists r]
} -result {0 0 0}

test calc-43.8 {=> the _ skip still counts as a slot} -constraints hasCalcCmd -body {
    = (1,2,3) => (p,_,r)
    list $p $r
} -result {1 3} -cleanup {
    unset -nocomplain p r
}

test calc-43.9 {=> a single name takes the whole value} -constraints hasCalcCmd -body {
    = (1,2,3) => p
    set p
} -result {1 2 3} -cleanup {
    unset -nocomplain p
}

test calc-43.10 {-> stays lenient next to =>} -constraints hasCalcCmd -body {
    = (1,2) -> (p,q,r)
    list $p $q $r
} -result {1 2 {}} -cleanup {
    unset -nocomplain p q r
}

test calc-43.11 {=> inside a proc} -constraints hasCalcCmd -body {
    proc t43 {} {
        = (1,2,3) => (a,b,c)
        list $a $b $c
    }
    t43
} -result {1 2 3} -cleanup {
    rename t43 {}
}

test calc-43.12 {=> mismatch inside a proc} -constraints hasCalcCmd -body {
    proc t43 {} {
        = (1,2,3) => (a,b)
    }
    t43
} -returnCodes error -match glob -result {*pattern (a,b) expects 2, data has 3*} -cleanup {
    rename t43 {}
}

test calc-43.13 {>= and == are unaffected by the => token} -constraints hasCalcCmd -body {
    list [= 4 >= 3] [= 3 == 3] [= 2 >= 3]
} -result {1 1 0}

# ============================================================================
# CLEANUP
# ============================================================================

cleanupTests
